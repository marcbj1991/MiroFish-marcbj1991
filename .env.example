# ===== LLM 配置 / LLM configuration =====
# LLM_PROVIDER: anthropic (default, Claude via the official Anthropic SDK)
#               or openai (any OpenAI-compatible server; only then is LLM_BASE_URL used)
# 注意消耗较大，可先进行小于40轮的模拟尝试
# Cheaper Claude model: LLM_MODEL_NAME=claude-haiku-5-5 ; local server: LLM_PROVIDER=openai + LLM_BASE_URL=http://localhost:11434/v1 (e.g. Ollama)
LLM_PROVIDER=anthropic
LLM_API_KEY=your_anthropic_api_key_here
LLM_MODEL_NAME=claude-opus-5-5

# ===== 知识图谱 / Knowledge graph =====
# Stored locally in SQLite (backend/uploads/graph/graph.sqlite3); no key or external service.

# ===== 加速 LLM 配置（可选）/ Boost LLM (optional) =====
# Uses the same LLM_PROVIDER; with anthropic, LLM_BOOST_BASE_URL is ignored.
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
