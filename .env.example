# ===== LLM configuration =====
# LLM_PROVIDER: anthropic (default, Claude via the official Anthropic SDK)
#               or openai (any OpenAI-compatible server; only then is LLM_BASE_URL used)
# LLM_API_KEY:  the key of that provider.
#
# Models per stage (all optional):
#   LLM_MODEL_GRAPH       graph: ontology generation and entity extraction
#                         from the uploaded documents
#   LLM_MODEL_SIMULATION  simulation: agent profiles, simulation config, the OASIS
#                         agents and the extraction of agent activity into the
#                         graph during a run (high volume: use a fast model)
#   LLM_MODEL_REPORT      report: the report agent, its chat and its tools
# Precedence for each stage: its own variable if set; otherwise LLM_MODEL_NAME
# if set (one model everywhere); otherwise the provider's built-in default.
# Simulations are costly: try runs of fewer than 40 rounds first.

# --- Anthropic (active) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=your_anthropic_api_key_here
# Built-in stage defaults (uncomment only to change one):
# LLM_MODEL_GRAPH=claude-sonnet-5-5
# LLM_MODEL_SIMULATION=claude-haiku-5-5
# LLM_MODEL_REPORT=claude-opus-5-5
# One cheap model for every stage instead:
# LLM_MODEL_NAME=claude-haiku-5-5

# --- OpenAI / ChatGPT (commented) ---
# The same block works for any OpenAI-compatible server,
# e.g. a local Ollama: LLM_BASE_URL=http://localhost:11434/v1
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL_NAME=<model for any stage left unset>
# LLM_MODEL_GRAPH=<strong model>
# LLM_MODEL_SIMULATION=<small fast model>
# LLM_MODEL_REPORT=<strong model>

# ===== Knowledge graph =====
# Stored locally in SQLite (backend/uploads/graph/graph.sqlite3); no key or external service.

# ===== Boost LLM (optional) =====
# A second key for one platform of the parallel simulation, to raise throughput.
# Uses the same LLM_PROVIDER; with anthropic, LLM_BOOST_BASE_URL is ignored.
# LLM_BOOST_MODEL_NAME overrides the simulation model on that platform.
# If you do not use the boost, leave these lines out of .env entirely.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
